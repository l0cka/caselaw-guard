{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/l0cka/caselaw-guard/schemas/australia-index.schema.json",
  "title": "CaseLaw Guard Australian index file",
  "type": "object",
  "additionalProperties": false,
  "required": ["index_version", "generated_at", "builder_version", "source", "dataset_revision", "license", "attribution", "record_count", "entries"],
  "properties": {
    "index_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "builder_version": {"type": "string"},
    "source": {"type": "string"},
    "dataset_revision": {"type": "string"},
    "license": {"type": "string"},
    "attribution": {"type": "string"},
    "record_count": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/entry"},
          {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/entry"}}
        ]
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_citation", "citation", "case_name", "court_code", "date", "source_urls", "source", "source_record_ids", "indexed_at", "license"],
      "properties": {
        "normalized_citation": {"type": "string", "pattern": "^\\[\\d{4}\\] [A-Za-z][A-Za-z0-9]* \\d+$"},
        "citation": {"type": "string"},
        "case_name": {"type": "string"},
        "court": {"type": ["string", "null"]},
        "court_code": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "jurisdiction": {"type": ["string", "null"]},
        "date": {"type": "string", "format": "date"},
        "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
        "source": {"type": "string"},
        "source_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "indexed_at": {"type": "string", "format": "date"},
        "license": {"type": "string"}
      }
    }
  }
}
